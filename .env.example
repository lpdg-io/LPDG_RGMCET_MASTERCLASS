# ---------------------------------------------------------------
# Snowflake connection parameters  (TEMPLATE)
#
# Copy this file to `.env` at the repo root and fill in real values:
#     cp .env.example .env
#
# `.env` itself is git-ignored and must never be committed.
# ---------------------------------------------------------------

# Account identifier: <ORG_NAME>-<ACCOUNT_NAME>
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT

# Login credentials
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PASSWORD=YOUR_PASSWORD

# Session context
SNOWFLAKE_ROLE=YOUR_ROLE
SNOWFLAKE_WH=YOUR_WAREHOUSE
SNOWFLAKE_DB=YOUR_DATABASE
SNOWFLAKE_SCHEMA=YOUR_SCHEMA

# Optional: use instead of SNOWFLAKE_PASSWORD for SSO / browser auth.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
